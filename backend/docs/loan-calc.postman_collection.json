{
  "info": {
    "name": "Credit Sea Loan API",
    "description": "All backend endpoints. Run Auth > Send OTP, then Verify OTP; tokens and ids are saved into collection variables. See backend/README.md.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health",
      "description": "",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "health"
              ]
            },
            "description": ""
          }
        }
      ]
    },
    {
      "name": "Auth",
      "description": "",
      "item": [
        {
          "name": "Send OTP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/send-otp",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "send-otp"
              ]
            },
            "description": "OTP_MODE=demo always uses 123456. 30s cooldown between requests per number.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"{{phone}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Verify OTP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/verify-otp",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "verify-otp"
              ]
            },
            "description": "Creates the user on first login. Saves accessToken and refreshToken into collection variables.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"{{phone}}\",\n  \"otp\": \"123456\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.success && res.data && res.data.accessToken) {",
                  "  pm.collectionVariables.set('accessToken', res.data.accessToken);",
                  "  pm.collectionVariables.set('refreshToken', res.data.refreshToken);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh tokens",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/refresh",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "refresh"
              ]
            },
            "description": "Rotates both tokens: the old refresh token stops working.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.success && res.data && res.data.accessToken) {",
                  "  pm.collectionVariables.set('accessToken', res.data.accessToken);",
                  "  pm.collectionVariables.set('refreshToken', res.data.refreshToken);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/logout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "logout"
              ]
            },
            "description": "Revokes the current refresh token."
          }
        }
      ]
    },
    {
      "name": "Users",
      "description": "",
      "item": [
        {
          "name": "Get my profile",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/users/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users",
                "me"
              ]
            },
            "description": ""
          }
        },
        {
          "name": "Update my profile",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/users/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users",
                "me"
              ]
            },
            "description": "Any subset of fields. PAN must be unique across users.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Asha Verma\",\n  \"dob\": \"1994-05-10\",\n  \"gender\": \"female\",\n  \"pan\": \"{{pan}}\",\n  \"email\": \"asha@example.com\",\n  \"monthlyIncome\": 60000,\n  \"employmentType\": \"salaried\",\n  \"city\": \"Pune\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Get my credit score",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/users/me/credit-score",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users",
                "me",
                "credit-score"
              ]
            },
            "description": "Score (300-900), band and the 10 most recent changes."
          }
        }
      ]
    },
    {
      "name": "Loans",
      "description": "",
      "item": [
        {
          "name": "Calculate EMI (public)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/loans/calculate",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "loans",
                "calculate"
              ]
            },
            "description": "No login needed. Flat 12% p.a. Amount 10,000-5,00,000, tenure 3-60 months.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 100000,\n  \"tenureMonths\": 12\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Check eligibility",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/loans/eligibility",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "loans",
                "eligibility"
              ]
            },
            "description": "Returns eligible, maxEligibleAmount and plain-language reasons.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 100000,\n  \"tenureMonths\": 12\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Apply for a loan",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/loans/apply",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "loans",
                "apply"
              ]
            },
            "description": "Re-runs eligibility on the server. 409 if you already have a submitted or under_review application. Saves loanId.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 100000,\n  \"tenureMonths\": 12,\n  \"purpose\": \"Home renovation\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "const loan = res.success && res.data && (res.data.application || res.data.loan);",
                  "if (loan && loan._id) { pm.collectionVariables.set('loanId', loan._id); }"
                ]
              }
            }
          ]
        },
        {
          "name": "List my applications",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/loans?page=1&limit=10",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "loans"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            },
            "description": "Newest first, with pagination."
          }
        },
        {
          "name": "Get one application",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/loans/{{loanId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "loans",
                "{{loanId}}"
              ]
            },
            "description": "Includes statusHistory (the timeline)."
          }
        }
      ]
    },
    {
      "name": "Admin (x-admin-api-key)",
      "description": "Run top to bottom: under review -> auto-decision -> disburse. The two manual requests are alternatives to auto-decision and return 409 after it. Set adminApiKey to the ADMIN_API_KEY from backend/.env.",
      "item": [
        {
          "name": "Move to under_review",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-admin-api-key",
                "value": "{{adminApiKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/loans/{{loanId}}/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "loans",
                "{{loanId}}",
                "status"
              ]
            },
            "description": "Step 1 of the happy path. Allowed: submitted -> under_review -> approved/rejected, approved -> disbursed.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"under_review\",\n  \"note\": \"Picked up for review\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Auto-decision",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "x-admin-api-key",
                "value": "{{adminApiKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/loans/{{loanId}}/auto-decision",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "loans",
                "{{loanId}}",
                "auto-decision"
              ]
            },
            "description": "Only from under_review. Re-runs eligibility and moves the loan to approved or rejected."
          }
        },
        {
          "name": "Disburse",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-admin-api-key",
                "value": "{{adminApiKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/loans/{{loanId}}/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "loans",
                "{{loanId}}",
                "status"
              ]
            },
            "description": "Creates the repayment schedule.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"disbursed\",\n  \"note\": \"Loan disbursed\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Approve manually (instead of auto-decision)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-admin-api-key",
                "value": "{{adminApiKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/loans/{{loanId}}/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "loans",
                "{{loanId}}",
                "status"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"approved\",\n  \"note\": \"Approved\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Reject manually (instead of auto-decision)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-admin-api-key",
                "value": "{{adminApiKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/loans/{{loanId}}/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "loans",
                "{{loanId}}",
                "status"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"rejected\",\n  \"note\": \"Income could not be verified\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "Repayments",
      "description": "",
      "item": [
        {
          "name": "List repayment schedule",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/loans/{{loanId}}/repayments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "loans",
                "{{loanId}}",
                "repayments"
              ]
            },
            "description": "409 until the loan is disbursed."
          }
        },
        {
          "name": "Pay an installment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/loans/{{loanId}}/repayments/{{installment}}/pay",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "loans",
                "{{loanId}}",
                "repayments",
                "{{installment}}",
                "pay"
              ]
            },
            "description": "Simulated payment. Installments are paid in order. On time: +10 credit score. Late: -20. Last installment: +30 bonus."
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://credit-sea-api.onrender.com",
      "description": "Server origin, without /api. The deployed API by default; use http://localhost:5000 for a local backend. The free server can take up to a minute to wake on the first request."
    },
    {
      "key": "phone",
      "value": "9876543210"
    },
    {
      "key": "pan",
      "value": "PQRST1234U",
      "description": "PAN is unique per user. Change it if another account already uses it."
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "refreshToken",
      "value": ""
    },
    {
      "key": "loanId",
      "value": ""
    },
    {
      "key": "installment",
      "value": "1"
    },
    {
      "key": "adminApiKey",
      "value": "",
      "description": "Copy ADMIN_API_KEY from backend/.env. Keep it out of version control."
    }
  ]
}