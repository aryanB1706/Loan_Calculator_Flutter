# Server
NODE_ENV=development
PORT=5000

# Database
MONGO_URI=mongodb://127.0.0.1:27017/loan_calc

# CORS (comma separated origins, or * for all)
CORS_ORIGIN=*

# Admin API (at least 16 characters; required in production)
# Sent as the x-admin-api-key header. Replace with a long random value.
ADMIN_API_KEY=replace_me_with_a_long_random_admin_api_key

# JWT (use long random strings, at least 32 characters)
JWT_ACCESS_SECRET=replace_me_with_a_long_random_access_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_me_with_a_long_random_refresh_secret
JWT_REFRESH_EXPIRES_IN=7d

# OTP
# mode: demo (fixed 123456, no SMS, blocked in production), console (random OTP
# printed in server logs), sms (real provider configured below)
OTP_MODE=demo
# Used only when OTP_MODE=sms: fast2sms or msg91
OTP_SMS_PROVIDER=msg91
OTP_EXPIRES_IN_MINUTES=5
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_ATTEMPTS=3

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
SEND_OTP_RATE_LIMIT_WINDOW_MS=900000
SEND_OTP_RATE_LIMIT_MAX=5
